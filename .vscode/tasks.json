{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TV2 · Web và Firebase Emulator",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "tools/preview.py"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "tv2",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^TV2 START",
          "endsPattern": "^TV2 READY"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
